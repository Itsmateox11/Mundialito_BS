# Base de datos local. SQLite guarda el archivo junto al esquema:
# la ruta es relativa a la carpeta prisma/, así que esto crea prisma/dev.db
DATABASE_URL="file:./dev.db"

# URL pública del despliegue. Se usa para metadatos absolutos y el sitemap.
# En desarrollo puede quedarse sin definir.
# NEXT_PUBLIC_SITE_URL=https://mundialito.colsantander.edu.co

# Ingreso: "off" deja el formulario en blanco y oculta la contrasena demo.
NEXT_PUBLIC_DEMO_AUTOFILL=on
